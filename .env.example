# Environment Configuration
# Copy this file to .env and fill in your values

# Application Environment
CI_ENV=development

# Database Configuration
# For Docker local DB: use DB_HOSTNAME=db
# For SSH tunnel to remote DB: use DB_HOSTNAME=host.docker.internal
DB_HOSTNAME=db
DB_PORT=3306
DB_USERNAME=zerone
DB_PASSWORD=zerone_password
DB_DATABASE=zerone_japan
DB_DRIVER=mysqli

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_PROJECT_ID=your_project_id_here
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_REDIRECT_URI_PROD=https://yourdomain.com/callback
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:8080/callback

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_PORT_SSL=465
SMTP_PORT_TLS=587

# RapidAPI Configuration (TikTok sync)
RAPIDAPI_HOST=tiktok-video-no-watermark10.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key
TIKTOK_SESSION_COOKIE=your_tiktok_session_cookie

# ScrapingBot Configuration (Instagram async queue)
SCRAPINGBOT_USERNAME=your_scrapingbot_username
SCRAPINGBOT_API_KEY=your_scrapingbot_api_key
SCRAPINGBOT_BASE_URL=http://api.scraping-bot.io

# Threads External Scraping API Configuration (Threads only)
THREADS_SCRAP_BASE_URL=scrap.threadsapi.com
THREADS_SCRAP_API_KEY=your_threads_scrap_api_key
THREADS_SCRAP_TIMEOUT=30

# Endorse V2 rollout controls — all must remain disabled until the staged cutover runbook is complete.
ENDORSE_V2_READ=0
ENDORSE_V2_ENQUEUE=0
ENDORSE_V2_WRITER=0
ENDORSE_V2_ROLLUP=0
ENDORSE_V2_ANALYTICS=off
ENDORSE_V2_THREADS=0
ENDORSE_V2_OPTIMIZATION=0
# Required only by the signed internal POST /api/internal/endorse-v2/tick endpoint.
ENDORSE_V2_CRON_SECRET=

# Base URL (optional - auto-detected if not set)
# BASE_URL=http://localhost:8080/
